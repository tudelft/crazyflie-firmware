CONFIG_PLATFORM_FLAPPER3=y

CONFIG_ESTIMATOR_AUTO_SELECT=y
CONFIG_CONTROLLER_PID=y

CONFIG_MOTORS_ESC_PROTOCOL_STANDARD_PWM=y

CONFIG_CONTROLLER_PID_FILTER_ALL=y
# CONFIG_CONTROLLER_PID_IMPROVED_BARO_Z_HOLD=y

# ---------------------------------------------------------------------------
# Flapper Nimble TRIPLE (3-wing) flow-only build with the AE3 forward camera.
# = the Triple's flapper3 mixing (power_distribution_flapper3.c) PLUS the
# IMAV2026 estimation/deck stack:
#   - CONFIG_DECK_MTF02=y  -> MTF-02 optical flow on UART1 (flow-only EKF)
#   - CONFIG_DECK_USD=y    -> SD-card logging on SPI
#   - CONFIG_DECK_AE3=y    -> AE3 forward camera float on UART2 -> ae3.dist
#   - CPPM DISABLED        -> CPPM captures on PA3 = UART2 RX; we fly from
#                             Python/CRTP (no RC), so free PA3 for the AE3.
# The tuned flow-only EKF (drag, flowdeck lever arm) comes from
# platform_defaults_flapper3.h; the ToF innovation gate is compiled into the
# Kalman core. Re-validate the EKF drag/lever-arm on the Triple airframe.
# Bus map: MTF-02 = UART1, AE3 = UART2, USD = SPI.
# ---------------------------------------------------------------------------
CONFIG_DECK_USD=y
CONFIG_DECK_MTF02=y
CONFIG_DECK_AE3=y

# Flow-only estimation needs the Kalman EKF.
CONFIG_ESTIMATOR_KALMAN=y
CONFIG_ESTIMATOR_KALMAN_ENABLE=y

CONFIG_DECK_FORCE="bcMTF02:bcUSD:bcAE3"

CONFIG_DECK_FLAPPER_EXTRX_ENABLE=n # Enable external receiver

# CPPM disabled so PA3 is free for UART2 RX (AE3). Commanded from Python/CRTP.
# CONFIG_DECK_CPPM is not set
# CONFIG_DECK_CPPM_USE_PA3 is not set

# --- Flapper Nimble Triple power distribution ---
# Set the PCB revision to match your unit (serial NTA -> revA, NTB -> revB).
# revB is the common current hardware; flip these two for a revA unit.
CONFIG_POWER_DISTRIBUTION_FLAPPER3_REVB=y
CONFIG_POWER_DISTRIBUTION_FLAPPER3_SERVO_INVERTED=y
