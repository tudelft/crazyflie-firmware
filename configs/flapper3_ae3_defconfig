CONFIG_PLATFORM_FLAPPER3=y
CONFIG_CONTROLLER_PID=y
CONFIG_MOTORS_ESC_PROTOCOL_STANDARD_PWM=y
CONFIG_CONTROLLER_PID_FILTER_ALL=y

# IMAV2026: MTF-02 on UART1, AE3 on UART2, USD on SPI.
CONFIG_DECK_USD=y
CONFIG_DECK_MTF02=y
CONFIG_DECK_AE3=y
CONFIG_DECK_FORCE="bcMTF02:bcUSD:bcAE3"
# CONFIG_DECK_LOCO is not set
# CONFIG_DECK_CPPM is not set
CONFIG_ESTIMATOR_KALMAN=y
CONFIG_ESTIMATOR_KALMAN_ENABLE=y

# Default Triple motor mapping with the upside-down yaw servo.
CONFIG_POWER_DISTRIBUTION_FLAPPER3_SERVO_INVERTED=y
# For revB, also enable CONFIG_POWER_DISTRIBUTION_FLAPPER3_REVB.
